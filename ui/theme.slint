// Neutral macOS-style palette: system grays, the system accent blue, and the standard
// green/red/yellow status colors, tuned to keep text at WCAG AA contrast.
export global Theme {
    in-out property <int> mode: 0;
    in-out property <bool> system-light: false;
    out property <bool> light: root.mode == 2 || (root.mode == 0 && root.system-light);

    out property <color> bg: root.light ? #f5f5f7 : #1c1c1e;
    out property <color> surface: root.light ? #ffffff : #242426;
    out property <color> grid: root.light ? #fbfbfd : #1f1f21;
    out property <color> row-alt: root.light ? #f2f2f5 : #262628;
    out property <color> panel: root.light ? #ffffff : #1a1a1c;
    out property <color> menu: root.light ? #ffffff : #2c2c2e;
    out property <color> hover: root.light ? #e8e8ed : #36363a;
    out property <color> hover-strong: root.light ? #dedee3 : #2c2c30;
    out property <color> selected: root.light ? #d3e5fc : #17406e;
    out property <color> selected-soft: root.light ? #e8f1fd : #1d324b;
    out property <color> border: root.light ? #d2d2d7 : #38383a;
    out property <color> border-strong: root.light ? #b0b0b8 : #545458;
    out property <color> line: root.light ? #e5e5ea : #2e2e30;
    out property <color> divider: root.light ? #d8d8dc : #3a3a3c;
    out property <color> text: root.light ? #1d1d1f : #f5f5f7;
    out property <color> text-strong: root.light ? #000000 : #ffffff;
    out property <color> text-body: root.light ? #3a3a3c : #d1d1d6;
    out property <color> heading: root.light ? #515154 : #aeaeb2;
    out property <color> label: root.light ? #48484a : #c7c7cc;
    out property <color> muted: root.light ? #6e6e73 : #a1a1a6;
    out property <color> muted-2: root.light ? #737378 : #98989d;
    out property <color> faint: root.light ? #86868b : #8e8e93;
    out property <color> icon-muted: root.light ? #8e8e93 : #636366;
    out property <color> error-bg: root.light ? #fdecec : #3a1f1f;
    out property <color> error-text: root.light ? #b3261e : #ffa39e;
    out property <color> ok: root.light ? #1f7a35 : #32d74b;
    out property <color> info: root.light ? #0066cc : #409cff;
    out property <color> info-soft: root.light ? #2a6fb8 : #70b4ff;
    out property <color> fail: root.light ? #d70015 : #ff6961;
    out property <color> warn: root.light ? #935d00 : #ffd60a;
    out property <color> splitter: root.light ? #c7c7cc : #48484a;
    out property <color> splitter-active: root.light ? #0071e3 : #0a84ff;
    out property <color> titlebar: root.light ? #ececee : #2a2a2c;
    out property <string> mode-label: root.mode == 1 ? "Appearance: Dark" : root.mode == 2 ? "Appearance: Light" : "Appearance: Match System";
}
